          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 200) {",
                "  pm.test('New org activated and login works', () => {",
                "    pm.expect(pm.response.json().data.user.role).to.eql('ORG_ADMIN');",
                "  });",
                "} else {",
                "  console.log('If 401/403: wait for stripe webhook, then retry this request');",
                "}"
              ]
            }
