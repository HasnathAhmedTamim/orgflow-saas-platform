    {
      "name": "10 — Paid Registration (Stripe Checkout)",
      "description": "Register NovaTech → open checkoutUrl in browser → pay 4242… → keep stripe listen running → then login.",
      "item": [
        {
          "name": "10.1 List plans for registration",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const plans = pm.response.json().data || [];",
                "const starter = plans.find(p => p.name === 'Starter') || plans[0];",
                "if (starter) pm.collectionVariables.set('planId', starter.id);"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/plans"
          }
        },
        {
          "name": "10.2 Register NovaTech (creates Checkout)",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Checkout created', () => pm.response.to.have.status(201));",
                "const d = pm.response.json().data;",
                "pm.collectionVariables.set('pendingId', d.pendingRegistrationId);",
                "pm.collectionVariables.set('checkoutUrl', d.checkoutUrl);",
                "console.log('=== OPEN IN BROWSER AND PAY ===');",
                "console.log(d.checkoutUrl);",
                "console.log('Card: 4242 4242 4242 4242');"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationName\": \"NovaTech Solutions\",\n  \"adminName\": \"Nadia Rahman\",\n  \"email\": \"nadia.rahman@novatech.io\",\n  \"password\": \"Password123!\",\n  \"planId\": \"{{planId}}\"\n}"
            },
            "url": "{{baseUrl}}/register"
          }
        },
        {
          "name": "10.3 Retry checkout (if payment abandoned)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/register/{{pendingId}}/retry"
